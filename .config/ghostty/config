# Performance & Memory
# Use a reasonable limit to prevent RAM ballooning
scrollback-limit = 50000 

window-width = 160
window-height = 30

# Rendering (Native macOS Metal)
font-family = "JetBrainsMono Nerd Font"
font-size = 13

# Mouse & Keyboard
macos-option-as-alt = true
copy-on-select = true

# Essential Splits (iTerm/WezTerm Style)
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface
keybind = cmd+]=goto_split:next
keybind = cmd+[=goto_split:previous


# Disable ligatures to save CPU cycles per character
font-feature = -calt
font-feature = -liga

# Disable blur/transparency for raw speed
background-blur-radius = 0
background-opacity = 1.0

# theme = Hax0R Blue
# theme = TokyoNight Moon
# theme = Matrix
# theme = Material Design Colors
# theme = Dracula+
theme = TokyoNight Night
